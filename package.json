{
  "name": "jobpilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "JobPilot \u2014 personal job-search agent: ingest postings, filter, score against a profile, emit a digest.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sources": "node src/cli.ts sources",
    "init": "node src/cli.ts init",
    "ui": "node src/server/server.ts",
    "profile": "node src/cli.ts profile",
    "collect": "node src/cli.ts collect",
    "score": "node src/cli.ts score",
    "digest": "node src/cli.ts digest",
    "run": "node src/cli.ts run",
    "discover": "node src/cli.ts discover",
    "dump": "node src/cli.ts dump",
    "feedback": "node src/cli.ts feedback",
    "eval": "node src/cli.ts eval",
    "stats": "node src/cli.ts stats",
    "boards": "node src/cli.ts boards",
    "discover-web": "node src/cli.ts discover-web",
    "funnel": "node src/cli.ts funnel",
    "schedule": "node src/cli.ts schedule",
    "test": "npm run typecheck && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "learn": "node src/cli.ts learn",
    "screenshot": "node scripts/screenshot.ts",
    "discover-list": "node src/cli.ts discover-list",
    "health": "node src/cli.ts health",
    "backup": "node src/cli.ts backup",
    "agent": "node src/cli.ts agent"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "unpdf": "^2.2.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelavoyan/JobPilot.git"
  }
}
