# Copy to .env and fill in. .env is gitignored — NEVER put a key in this file.

# --- LLM: set ONE key ---
# OpenCode Go is a gateway that serves many models on one subscription.
# The others are direct provider keys.
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Model id for the provider whose key you set. There is no default: a wrong id
# fails at request time, not at startup.
#
#   opencode  -> deepseek-v4.1-flash, qwen4-max, gemini-4-argon, glm-5.3 ...
#                list them:
#                  curl -H "authorization: Bearer $KEY" \
#                       https://opencode.ai/inference/go/v1/models
#   anthropic -> e.g. claude-sonnet-4-5
#   deepseek  -> deepseek-chat
#   openai    -> e.g. gpt-4.1-mini
LLM_MODEL=

# Optional endpoint overrides (proxies, self-hosted gateways).
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: cost estimate in USD per million tokens. Only used when the
# provider does not report a charge itself.
# LLM_PRICE_IN=
# LLM_PRICE_OUT=

# --- optional: web discovery ---
# Finds companies by searching for their careers pages. One provider is enough;
# both are metered, so discovery is a weekly action, not a per-run one.
# BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# --- optional: country-wide feed (Adzuna) ---
# Free keys from developer.adzuna.com. Covers us, uk, de, fr and 12 more —
# not Israel. Set the market's adzuna_country to match.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_PAGES=3

# --- optional: config location ---
# Point at a config directory other than ./config, and pick a market template
# for `npm run init` (il | us).
# JOBCONFIG_DIR=
# JOBCONFIG_MARKET=il

# --- optional: Telegram digest ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- tuning ---
MIN_SCORE=65
BATCH_SIZE=6

# --- the agent ---
# A daily cap on model spend, in dollars. Past it, scoring is skipped.
AGENT_MONTHLY_CAP_USD=5
# Fewer matches than this in a week, and it goes looking for new companies.
AGENT_MIN_MATCHES=3
# How many companies one discovery pass may probe.
AGENT_DISCOVERY_LIMIT=40
# 1 stops the agent without uninstalling the schedule.
AGENT_PAUSED=0

# Score every posting this many times and average the result. The model is not
# deterministic: two identical runs can differ by more than ten points. 2 halves
# that noise at twice the model cost. Allowed: 1-3.
SCORE_SAMPLES=1

# Test hook: point Telegram calls at a local stub instead of the real API.
# TELEGRAM_API_BASE=http://127.0.0.1:9999
